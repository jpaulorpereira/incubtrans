<%- include('_head') %>
<% const val = (it, f) => it ? (it[f.k] ?? '') : (f.type === 'status' || f.type === 'onoff' ? 'ativo' : f.type === 'kind' ? 'evento' : ''); %>
<div class="grid2" style="grid-template-columns:1.3fr 1fr;align-items:start">
  <section class="card pad">
    <h2 style="font-size:20px;margin-bottom:14px"><%= t('area.tabs.' + slug) %> <span class="muted" style="font-size:15px">(<%= items.length %>)</span></h2>
    <% if (!items.length) { %><p class="muted"><%= t('area.nenhum') %></p><% } %>
    <% items.forEach(it => { %>
      <div class="item-row">
        <div class="row between" style="align-items:flex-start">
          <div style="min-width:0;flex:1">
            <div class="row" style="gap:8px"><% if (it.kind) { %><span class="pill <%= it.kind === 'evento' ? 'violet' : 'blue' %>"><%= it.kind === 'evento' ? t('lbl.evento') : t('lbl.noticia') %></span><% } %><b style="font-family:var(--display)"><%= it.name || it.title %></b><% if (it.status) { %><span class="pill <%= it.status %>"><%= statusLabel(it.status) %></span><% } %></div>
            <div class="tiny muted" style="margin-top:4px">
              <%= [it.date && U.formatDate(it.date), it.duration_months && `${it.duration_months} ${t('lbl.meses')}`, (it.start_date || it.end_date) && `${U.formatDate(it.start_date)} – ${U.formatDate(it.end_date)}`, it.year, it.area, it.place, it.website && U.displayUrl(it.website)].filter(Boolean).join(' · ') %>
            </div>
            <% if (it.description || it.body) { %><p class="small" style="color:var(--muted);margin-top:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"><%= it.description || it.body %></p><% } %>
          </div>
          <div class="row" style="gap:6px;flex:none">
            <a class="btn ghost sm" href="?editar=<%= it.id %>#form"><%= t('btn.editar') %></a>
            <form method="post" action="/area/<%= slug %>/<%= it.id %>/eliminar" class="inline js-confirm" data-confirm="<%= t('area.confirmEliminar') %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm"><%= t('btn.eliminar') %></button></form>
          </div>
        </div>
      </div>
    <% }) %>
  </section>
  <form class="card pad side" id="form" method="post" action="/area/<%= slug %><%= edit ? '/' + edit.id : '' %>?_csrf=<%= csrf %>" enctype="multipart/form-data">
    <h2 style="font-size:19px;margin-bottom:16px"><%= edit ? t('btn.editar') : t('btn.adicionar') %></h2>
    <% C.fields.forEach(f => { const v = val(edit, f); const id = 'it-' + f.k; %>
      <div class="field"><label class="l" for="<%= id %>"><%= t(f.label) %><%= f.req ? ' *' : '' %></label>
      <% if (f.type === 'textarea') { %><textarea class="input" id="<%= id %>" name="<%= f.k %>" maxlength="<%= f.max %>"><%= v %></textarea>
      <% } else if (f.type === 'status') { %><select class="input" id="<%= id %>" name="<%= f.k %>"><% ['ativo', 'inativo', 'terminado'].forEach(s => { %><option value="<%= s %>" <%= v === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select>
      <% } else if (f.type === 'onoff') { %><select class="input" id="<%= id %>" name="<%= f.k %>"><% ['ativo', 'inativo'].forEach(s => { %><option value="<%= s %>" <%= v === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select>
      <% } else if (f.type === 'kind') { %><select class="input" id="<%= id %>" name="<%= f.k %>"><option value="evento" <%= v === 'evento' ? 'selected' : '' %>><%= t('lbl.evento') %></option><option value="noticia" <%= v === 'noticia' ? 'selected' : '' %>><%= t('lbl.noticia') %></option></select>
      <% } else { %><input class="input" id="<%= id %>" name="<%= f.k %>" value="<%= v %>" type="<%= f.type === 'number' ? 'number' : f.type === 'date' ? 'date' : 'text' %>" <%= f.req ? 'required' : '' %> <%= f.max ? `maxlength=${f.max}` : '' %> <%= f.type === 'url' ? 'placeholder=https://' : '' %>><% } %>
      </div>
    <% }) %>
    <% if (C.image) { %>
      <div class="field"><span class="l"><%= C.image === 'logo' ? t('area.logo') : t('area.imagens') %></span>
        <% if (edit && edit[C.image]) { %><img src="<%= edit[C.image] %>" alt="" style="max-height:60px;border-radius:8px;display:block;margin-bottom:6px"><label class="check tiny"><input type="checkbox" name="remove_file" value="1"> <%= t('area.removerImg') %></label><% } %>
        <input type="file" name="file" accept="image/jpeg,image/png,image/webp" aria-label="<%= t('area.imagens') %>"></div>
    <% } %>
    <div class="row"><button class="btn"><%= edit ? t('btn.guardarAlt') : t('btn.adicionar') %></button><% if (edit) { %><a class="btn light" href="/area/<%= slug %>"><%= t('btn.cancelar') %></a><% } %></div>
  </form>
</div>
<%- include('_foot') %>
