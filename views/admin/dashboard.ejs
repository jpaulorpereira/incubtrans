<%- include('_head') %>
<div class="grid4" style="margin-bottom:24px">
  <% [[tr('Contas de entidades', 'Cuentas de entidades'), kpi.users, '/gestao/contas', 'var(--blue)'], [tr('Validações pendentes', 'Validaciones pendientes'), counts.pend, '/gestao/contas?estado=pendente', '#D97706'], [tr('Denúncias por tratar', 'Denuncias por tratar'), counts.reports, '/gestao/moderacao', 'var(--bad)'], [tr('Selos a rever', 'Sellos a revisar'), counts.reval, '/gestao/contas?estado=revalidar', 'var(--violet)']].forEach(([l, v, u, c]) => { %>
    <a class="card kpi-card" href="<%= u %>" style="color:inherit;text-decoration:none"><div class="top"><%= l %><span class="dot" style="background:<%= c %>"></span></div><div class="v"><%= v %></div><div class="how" style="color:var(--blue)"><%= tr('Ver', 'Ver') %> →</div></a>
  <% }) %>
</div>
<div class="grid4" style="margin-bottom:24px">
  <div class="card kpi-card"><div class="top"><%= tr('Ofertas ativas', 'Ofertas activas') %></div><div class="v"><%= kpi.offers %></div></div>
  <div class="card kpi-card"><div class="top"><%= tr('Visualizações (30 dias)', 'Visualizaciones (30 días)') %></div><div class="v"><%= U.formatNumber(kpi.views30) %></div></div>
  <div class="card kpi-card"><div class="top"><%= tr('Contactos (30 dias)', 'Contactos (30 días)') %></div><div class="v"><%= U.formatNumber(kpi.contacts30) %></div></div>
  <a class="card kpi-card" href="/gestao/destaques" style="color:inherit;text-decoration:none"><div class="top"><%= tr('Pedidos de destaque', 'Solicitudes de destacado') %></div><div class="v"><%= counts.hl %></div></a>
</div>
<div class="grid2" style="align-items:start">
  <section class="card pad">
    <div class="row between"><h2 style="font-size:19px"><%= tr('Registos a validar', 'Registros por validar') %></h2><a class="small" href="/gestao/contas?estado=pendente"><%= t('btn.verTodos') %> →</a></div>
    <% if (!pending.length) { %><p class="muted" style="margin-top:10px"><%= t('lbl.semDados') %></p><% } %>
    <% pending.forEach(u => { %><div class="item-row row between" style="margin-top:10px"><div><b><%= u.entity_name %></b><div class="tiny muted"><%= t('lbl.' + u.type) %> · <%= u.email %> · <%= U.formatDate(u.created_at) %> <%= u.email_verified ? '' : '· ' + tr('email por confirmar', 'email sin confirmar') %></div></div><a class="btn ghost sm" href="/gestao/contas/<%= u.id %>"><%= tr('Rever', 'Revisar') %></a></div><% }) %>
  </section>
  <section class="card pad">
    <div class="row between"><h2 style="font-size:19px"><%= tr('Denúncias recentes', 'Denuncias recientes') %></h2><a class="small" href="/gestao/moderacao"><%= t('btn.verTodos') %> →</a></div>
    <% if (!reports.length) { %><p class="muted" style="margin-top:10px"><%= t('lbl.semDados') %></p><% } %>
    <% reports.forEach(r => { %><div class="item-row" style="margin-top:10px"><span class="pill aberta"><%= r.target_type %></span> <b><%= r.label %></b><div class="tiny muted"><%= t('report.motivos.' + r.reason) %> · <%= U.formatDate(r.created_at) %></div></div><% }) %>
  </section>
</div>
<%- include('_foot') %>
