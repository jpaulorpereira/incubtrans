<%- include('partials/head', { band: { title: t('nav.produtos'), sub: lang === 'es' ? 'Escaparate territorial' : 'Montra territorial' } }) %>
<div class="wrap page">
  <div class="listing">
    <form class="card filters" method="get" action="/produtos" role="search">
      <h2><%= t('btn.filtrar') %></h2>
      <div class="f"><label class="l" for="f-q"><%= t('btn.pesquisar') %></label><input class="input" id="f-q" name="q" value="<%= f.q %>" type="search" data-suggest></div>
      <div class="f"><label class="l" for="f-t"><%= t('lbl.tipo') %></label>
        <select class="input" id="f-t" name="tipo"><option value=""><%= t('lbl.todos') %></option><option value="produto" <%= f.kind === 'produto' ? 'selected' : '' %>><%= t('lbl.produto') %></option><option value="servico" <%= f.kind === 'servico' ? 'selected' : '' %>><%= t('lbl.servico') %></option></select></div>
      <div class="f"><label class="l" for="f-c"><%= t('lbl.categoria') %></label>
        <select class="input" id="f-c" name="categoria"><option value=""><%= t('lbl.todos') %></option><% cats.forEach(c => { %><option value="<%= c.id %>" <%= String(f.category) === String(c.id) ? 'selected' : '' %>><%= lang === 'es' ? c.name_es : c.name_pt %></option><% }) %></select></div>
      <div class="f"><label class="l" for="f-l"><%= t('lbl.localizacao') %></label>
        <select class="input" id="f-l" name="local"><option value=""><%= t('lbl.todos') %></option>
          <% ['Portugal', 'Espanha'].forEach(cn => { const rs = regions.filter(r => r.country === cn); if (!rs.length) return; %>
            <optgroup label="<%= country(cn) %>"><option value="<%= cn %>" <%= f.region === cn ? 'selected' : '' %>><%= country(cn) %> — <%= t('lbl.todos').toLowerCase() %></option><% rs.forEach(r => { %><option value="<%= r.region %>" <%= f.region === r.region ? 'selected' : '' %>><%= r.region %></option><% }) %></optgroup>
          <% }) %>
          <% if (f.region && !regions.some(r => r.region === f.region) && !['Portugal','Espanha'].includes(f.region)) { %><option value="<%= f.region %>" selected><%= f.region %></option><% } %>
        </select></div>
      <input type="hidden" name="ordem" value="<%= f.sort || '' %>"><input type="hidden" name="vista" value="<%= view %>">
      <button class="btn block"><%= t('btn.filtrar') %></button>
      <% if (f.q || f.kind || f.category || f.region) { %><a class="btn light block" style="margin-top:10px" href="/produtos"><%= t('btn.limpar') %></a><% } %>
    </form>
    <div>
      <div class="toolbar">
        <span class="count" role="status"><%= result.total %> <%= result.total === 1 ? t('lbl.resultado') : t('lbl.resultados') %></span>
        <div class="right">
          <form method="get" action="/produtos" class="row" style="gap:8px">
            <% Object.entries(query).filter(([k]) => !['ordem', 'pagina'].includes(k)).forEach(([k, v]) => { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
            <label class="muted small" for="ord"><%= t('lbl.ordenar') %></label>
            <select class="input js-autosubmit" id="ord" name="ordem" style="width:auto;padding:9px 12px">
              <% [['', 'recentes'], ['nome', 'nomeAZ'], ['preco_asc', 'precoAsc'], ['preco_desc', 'precoDesc'], ['antigos', 'antigos']].forEach(([v, l]) => { %><option value="<%= v %>" <%= (f.sort || '') === v ? 'selected' : '' %>><%= t('lbl.' + l) %></option><% }) %>
            </select>
            <noscript><button class="btn sm">OK</button></noscript>
          </form>
          <div class="seg" role="group"><a href="<%= qs({ vista: 'grelha' }) %>" class="<%= view === 'grelha' ? 'on' : '' %>" title="<%= t('lbl.grelha') %>"><%- icon('grid', 16) %><span class="sr"><%= t('lbl.grelha') %></span></a><a href="<%= qs({ vista: 'lista' }) %>" class="<%= view === 'lista' ? 'on' : '' %>" title="<%= t('lbl.lista') %>"><%- icon('list', 16) %><span class="sr"><%= t('lbl.lista') %></span></a></div>
        </div>
      </div>
      <% if (!result.rows.length) { %><div class="card empty"><%= t('lbl.semResultados') %></div><% } %>
      <div class="<%= view === 'lista' ? 'list-view' : 'grid2' %>"><% result.rows.forEach(o => { %><%- include('partials/offer-card', { o }) %><% }) %></div>
      <%- include('partials/pager', { result }) %>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
